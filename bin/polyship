#!/usr/bin/env bash
# The per-machine command: runs ship.sh or merge.sh of the version it belongs to, with the settings given as
# arguments. No settings file and no settings env: a caller passes -o KEY=VALUE, as with polybrief.
# Contract: .archcore/architecture/polyship-cli.spec.md.
#
#   polyship ship [-C DIR] [-o KEY=VALUE]...            review, tests, the locked merge, conflict rounds
#   polyship merge [-C DIR] [-o KEY=VALUE]... [FLAGS]   only the locked merge; FLAGS go to wt merge
#   polyship config [-o KEY=VALUE]...                    every setting with its value and source
#   polyship check                                       the replay tests against this version's scripts
#   polyship --version
set -euo pipefail
self=$(perl -MCwd=abs_path -e 'print abs_path(shift)' "$0")
bin=$(dirname "$self"); root=$(dirname "$bin")

# key, the variable the scripts read, allowed values
settings='target MERGE_TARGET branch
push MERGE_PUSH remote
prepare MERGE_PREPARE command
test SHIP_TEST command
agent SHIP_AGENT claude|codex
review SHIP_REVIEW on|off
review_how SHIP_REVIEW_HOW text
rounds SHIP_ROUNDS number
stale_index_lock MERGE_STALE_INDEX_LOCK number'

die() { echo "polyship: $*" >&2; exit 2; }
usage() { sed -n 's/^#   \(polyship\)/\1/p' "$self" >&2; exit 2; }
version() { if [ -f "$root/VERSION" ]; then cat "$root/VERSION"; else echo dev; fi; }

set_kv() { # KEY=VALUE: check it, record it for export
  local k=${1%%=*} v=${1#*=} var kind
  [ "$k" != "$1" ] || die "bad override '$1' (use KEY=VALUE)"
  read -r var kind <<< "$(printf '%s\n' "$settings" | awk -v k="$k" '$1 == k { print $2, $3 }')"
  [ -n "${var:-}" ] || die "unknown setting '$k'"
  case $kind in
    on\|off) case $v in on) v=1 ;; off) v=0 ;; *) die "$k must be on or off, not '$v'" ;; esac ;;
    number) printf '%s' "$v" | grep -Eq '^[1-9][0-9]*$' || die "$k must be a whole number, not '$v'" ;;
    claude\|codex) case $v in claude|codex) ;; *) die "$k must be claude or codex, not '$v'" ;; esac ;;
  esac
  eval "set_$var=\$v"
}

cmd=${1:-}; [ $# = 0 ] || shift
case $cmd in --version|version) echo "polyship $(version)"; exit 0 ;; ship|merge|config|check) ;; *) usage ;; esac

dir=; rest=()
while [ $# -gt 0 ]; do
  case $1 in
    -C|-o) [ $# -ge 2 ] || die "$1 needs a value"; [ "$1" = -C ] && dir=$2 || set_kv "$2"; shift 2 ;;
    *) [ "$cmd" = merge ] || die "unexpected argument '$1'"; rest+=("$1"); shift ;;
  esac
done
[ -z "$dir" ] || cd "$dir" 2>/dev/null || die "no directory $dir"

# only arguments count: a variable left in the caller's shell does not reach the scripts
while read -r key var kind; do
  if eval "[ -n \"\${set_$var+x}\" ]"; then eval "export $var=\"\$set_$var\""; src=flag; else unset "$var"; src=default; fi
  val=${!var:-}; [ "$kind" != 'on|off' ] || case $val in 1) val=on ;; 0) val=off ;; esac
  [ "$cmd" != config ] || printf 'CONFIG\t%s\t%s\t%s\n' "$key" "$val" "$src"
done <<< "$settings"

case $cmd in
  config) ;;
  check) BIN=$bin exec "$root/lab/recover.sh" ;;
  *) git rev-parse --show-toplevel >/dev/null 2>&1 || die "$PWD is not in a git worktree"
     exec "$bin/$cmd.sh" ${rest[@]+"${rest[@]}"} ;;
esac
